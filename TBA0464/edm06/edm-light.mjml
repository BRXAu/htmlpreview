    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0" width="480px">

        <mj-text mj-class="text-color" padding="0px 25px" font-size="24px" line-height="30px" align="left">
          
    <table class="safe-table table-cta-border" role="presentation" width="120" border="0" cellpadding="0" cellspacing="0" style="width: 168px;">
        <tr>
          <td class="cta-text" valign="middle">
            <!--[if mso]><i style="letter-spacing: 10px; mso-font-width: -100%; display: none;">&nbsp;</i><![endif]--><a class="cta-text-url" href="https://www.bhp.com/xplor" target="_blank" style="">Register your interest</a>
          </td>
          <td class="cta-arrow" width="15" align="right" valign="middle">
            <a class="img-href" href="https://www.bhp.com/xplor" target="_blank">
              <img class="cta-arrow-img" src="./assets/tba0464-01-arrow.png" width="15" height="11" alt="">
            </a>
          </td>
        </tr>
      </table>
  
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0">
        <mj-spacer height="20px" padding="0"/>
      </mj-column>
    </mj-section>


    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0" width="480px">
        <mj-text mj-class="text-color"  padding="0px 25px" font-size="16px" font-weight="bold" line-height="26px" align="left" >
          Looking ahead
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0" width="480px">
        <mj-text mj-class="text-color"  padding="0px 25px" font-size="16px" line-height="26px" align="left" >
