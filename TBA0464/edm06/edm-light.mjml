<mjml>
  <mj-head>
     <mj-breakpoint width="600px" />
    <mj-attributes>
      

      <!-- Start custom variables
      Create any variables below.  In code reference as ${variable}

      Though better to place vars in data.json.


      End custom variables -->

      <mj-all
        font-family="Arial, Helvetica, sans-serif"
      />
      <mj-text
        font-family="Arial, Helvetica, sans-serif"
        font-size="16px"
        line-height="24px"
      />


      <mj-image name="hero-image" alt="BHP Xplor. Go further with BHP Xplor." padding="0" />
      <mj-image name="hero-desktop" css-class="desktop-image" src="./assets/tba0464-06-hero-desktop.jpg"  width="600px" />
      <mj-class name="hero-mobile" css-class="mobile-image" src="./assets/tba0464-06-hero-mobile.jpg" />
      <mj-class name="logo-image" css-class="both" src="./assets/tba0464-01-Logo.png" alt="BHP" width="46px" padding="0px 25px" align="left" href="https://www.bhp.com/"/>


      <mj-class name="invest-icon-01" css-class="both" src="./assets/tba0464-invest-icon-01.png" alt="Direct Access" width="60px" padding="0px" align="center"/>
      <mj-class name="invest-icon-02" css-class="both" src="./assets/tba0464-invest-icon-02.png" alt="Direct pre-vetted pipeline" width="60px" padding="0px" align="center"/>
      <mj-class name="invest-icon-03" css-class="both" src="./assets/tba0464-invest-icon-03.png" alt="Intimate deal focused setting" width="60px" padding="0px" align="center"/>

      <!-- Start colour scheme default -->
      <mj-class name="bg-color" background-color="#ffffff" />
      <mj-class name="text-color" color="#6C757D" />

      <mj-class name="module-01-color" background-color="#F9F7F5" color="#666666" />


      

      <mj-class name="pre-bg-color" background-color="#E0DDDB" />
      <mj-class name="pre-text-color" color="#000000"/>

      <mj-class name="footer-bg-color" background-color="#F9F7F5" />
      <mj-class name="footer-text-color" color="#707372" />
      <!-- End colour scheme default -->


      <!-- Start colour scheme dark --><!--

      <mj-class name="bg-color" background-color="#000000" />
      <mj-class name="text-color" color="#E0E0E0" />

      <mj-class name="module-01-color" background-color="#1A1A1A" color="#FFFFFF" />

      <mj-class name="pre-bg-color" background-color="#1E1E1E" />
      <mj-class name="pre-text-color" color="#FFFFFF"/>

      <mj-class name="footer-bg-color" background-color="#1A1A1A" />
      <mj-class name="footer-text-color" color="#A0A5A4" />

      --><!-- End colour scheme dark -->


    </mj-attributes>


    <mj-style>
      @media only screen and (max-width: 599px) {
        .mobile-image {
          display: block !important;
          width: 100% !important;
          height: auto !important;
        }
        .desktop-image {
          display: none !important;
        }

        .desktop-br {
          display: none !important;
          max-height: 0px !important;
          font-size: 0px !important;
          line-height: 0px !important;
        }
      }

      @media only screen and (min-width: 600px) {
        .desktop-image {
        display: block !important;
        width: 100% !important;
        height: auto !important;
        }
        .mobile-image {
          display: none !important;
        }
      }

      /* start css dark-mode */ /*
      .footer-raw-text {
        color: #A0A5A4!important
      }
      .pre-link-color {
        color: #FFFFFF!important
      }

      .cta-link {
        color: #FFFFFF!important;
      }

      .cta-text-url {
        color:#FFFFFF!important;
      }

      .table-content-text {
        color:#E0E0E0!important;
      }

      .table-content-date {
        color:#E0E0E0!important; 
      }

      .table-content-time {
        color:#E0E0E0!important; 
      }

      .table-content-address {
        color:#E0E0E0!important; 
      }


      */ /* end css dark-mode */
    </mj-style>

    <mj-style inline="inline">
      .cta-link {
        color: #343A40;
        font-weight: bold;
        text-decoration: none;
      }

      .cta-text {
        vertical-align: middle; 
        font-family: Arial, Helvetica, sans-serif; 
        font-size: 13px; 
        line-height: 16px; 
        color: #343A40; 
        padding: 10px 10px 10px 0;
      }

      .cta-text-url  { 
        color: #343A40; 
        text-decoration: none; 
        font-weight: bold; 
        font-size: 13px; 
        line-height: 16px;
        display: inline-block;
      }

      .cta-arrow {
        vertical-align: middle; width: 15px; padding: 0;
      }

      .cta-arrow-img { 
        display: block; 
        width: 15px; 
        height: 11px; 
        border: 0; 
        outline: none; 
        text-decoration: none;
      }

      .table-content-text {
        font-family:Arial, Helvetica, sans-serif; 
        font-size:16px; 
        line-height:20px; 
        color:#6C757D; 
        padding:0px 0px 10px 0px;
      }

      .table-content-bar { 
        width:3px; 
        background-color:#DD5900; 
        font-size:1px; 
        line-height:1px;
      }

      .table-content-date {
        font-family:Arial, Helvetica, sans-serif; 
        font-size:14px; 
        font-weight: bold;
        line-height:20px; 
        color:#666666; 
        padding:0px 0px 0px 0px;
      }

      .table-content-time {
        font-family:Arial, Helvetica, sans-serif; 
        font-size:12px; 
        font-weight: bold;
        line-height:14px; 
        color:#666666; 
        padding:0px 0px 0px 0px;
      }

      .table-content-address {
        font-family:Arial, Helvetica, sans-serif; 
        font-size:12px; 
        font-weight: regular;
        line-height:16px; 
        color:#666666; 
        padding:0px 0px 0px 0px;
      }

      .safe-table {
        border-collapse:collapse; 
        mso-table-lspace:0pt; 
        mso-table-rspace:0pt;

        border-collapse: collapse; 
        mso-table-lspace: 0pt; 
        mso-table-rspace: 0pt; 
      }

      .table-cta-border {
        border-bottom: 1px solid #DD5900;
      }

      .footer-text {
        text-align: left; 
        padding: 10px 0 0 25px; 
        font-family: Arial, Helvetica, sans-serif; 
        font-size: 10px; 
        line-height: 14px; 
        color: #707372; 
        -webkit-text-size-adjust: 100%; 
        -ms-text-size-adjust: 100%;
      }

      .footer-raw-text {
        font-family: Arial, Helvetica, sans-serif; font-size: 10px; line-height: 14px; display: block;
      }

      .footer-icon-img {
        display: block; 
        width: 28px; 
        height: 28px; 
        border: 0; 
        outline: none; 
        text-decoration: none; 
        -ms-interpolation-mode: bicubic;
      }

      .footer-icon-link {
        text-decoration: none; 
        display: block; 
        width: 28px;
      }

      .img-href {
        text-decoration: none; 
        display: block; 
        font-size: 0px; 
        line-height: 0px;
      }

      .pre-link-color {
        color: #000000; 
        text-decoration: underline;
      }

      .both {
        display: block !important;
      }


      .desktop-image {
        display: block;
        width: 100%;
        height: auto;
      }
      .mobile-image {
        display: none;
      }

    </mj-style>

  </mj-head>

  <mj-body mj-class="bg-color">
    <mj-section mj-class="pre-bg-color" padding="0">
      <mj-column padding="0" width="480px">
        <mj-text mj-class="pre-text-color" padding="10px 25px" font-size="10px" line-height="10px" align="center">
          Having trouble viewing this email? <a class="pre-link-color" href="#">View Online</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0">
      <mj-column>
        <mj-image mj-class="hero-image hero-desktop" />
        <!--[if !mso]><!-->
          <mj-image mj-class="hero-image hero-mobile"  />
        <!--<![endif]-->
      </mj-column>
    </mj-section>

    <mj-section padding="0">
      <mj-column padding="0">
        <mj-spacer height="30px" padding="0"/>
      </mj-column>
    </mj-section>

    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0" width="480px">
        <mj-text mj-class="text-color" padding="0px 25px 0px 25px" font-size="24px" line-height="30px" align="left">
          BHP&nbsp;Xplor&nbsp;Showcase: An&nbsp;Investor&nbsp;Event
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0">
        <mj-spacer height="20px" padding="0"/>
      </mj-column>
    </mj-section>
    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0" width="480px" >
        <mj-text mj-class="text-color" padding="0px 25px" font-size="24px" line-height="30px" align="left">
        <table class="safe-table" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0">
          <tr>
            <!-- Left Accent Bar with Outlook MSO fix -->
            <td class="table-content-bar" width="3" valign="top">&nbsp;</td>
            <!-- Content Padding Cell -->
            <td style="padding:10px 0 10px 30px;">
              
              <!-- Intro Text -->
              <table class="safe-table" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0">
                <tr>
                  <td class="table-content-date">
                    17 September 2026
                  </td>
                </tr>
              </table>
              <table class="safe-table" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0">
                <tr>
                  <td class="table-content-time">
                    09:00-18:00
                  </td>
                </tr>
              </table>

              <table class="safe-table" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0">
                <tr>
                  <td class="table-content-address">
                    Well&&nbsp;by&nbsp;Durst, 151&nbsp;West&nbsp;42nd&nbsp;Street, New&nbsp;York
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
        </mj-text>
      </mj-column>
    </mj-section>


    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0">
        <mj-spacer height="20px" padding="0"/>
      </mj-column>
    </mj-section>

    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0" width="480px">
        <mj-text mj-class="text-color"  padding="0px 25px" font-size="16px" line-height="26px" align="left" >
          BHP Xplor and 121 Mining Investment are hosting an invitation-only event connecting active mining investors with the 2026 BHP Xplor cohort, ten exploration and technology companies advancing projects with real growth potential.
          <br/><br/>
          This is a curated deal-sourcing opportunity. Every company has been selected to participate in BHP Xplor through a rigorous technical review process. The event gives investors early visibility to where they stand&nbsp;now.

        </mj-text>
      </mj-column>
    </mj-section>


    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0">
        <mj-spacer height="20px" padding="0"/>
      </mj-column>
    </mj-section>



