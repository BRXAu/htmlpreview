<mjml>
  <mj-head>
     <mj-breakpoint width="600px" />
    <mj-attributes>
      

      <!-- Start custom variables
      Create any variables below.  In code reference as ${variable}
      Run node watch.js to export files

      font.family="Arial, Helvetica, sans-serif"
      localPath=""
      bucket="https://tba0564-edm.s3.ap-southeast-2.amazonaws.com/"
      gitpreview="https://brxau.github.io/htmlpreview/TBA0464/edm01/"
      urlpath=""

      hero.desktop.src="tba0464-02-hero-desktop.jpg"
      hero.mobile.src="tba0464-02-hero-mobile.jpg"
      hero.alt="BHP Xplor. Go further with BHP Xplor."

      icon01.src="tba0464-01-icon-fb.png"
      icon01.alt="Facebook"
      icon01.url="https://www.facebook.com/BHP/"

      icon02.src="tba0464-01-icon-insta.png"
      icon02.alt="LinkedIn"
      icon02.url="https://www.linkedin.com/company/bhp"

      icon03.src="tba0464-01-icon-yt.png"
      icon03.alt="YouTube"
      icon03.url="https://www.youtube.com/BHP"

      logo.src="tba0464-01-Logo.png"
      logo.alt="BHP"
      logo.url="https://www.bhp.com/"

      cta.arrow.src="tba0464-01-arrow.png"

      cta01.text="Orion Minerals"
      cta01.url="#"
      
      cta02.text="FrontierX"
      cta02.url="#"

      cta03.text="Apply now"
      cta03.url="https://www.bhp.com/xplor"


      
      End custom variables -->

      <mj-all
        font-family="${font.family}"
        color="#222222"
      />
      <mj-text
        font-family="${font.family}"
        font-size="16px"
        line-height="24px"
      />


      <mj-image name="hero-image" alt="${hero.alt}" padding="0" />
      <mj-image name="hero-desktop" css-class="desktop-image" src="${urlpath}${hero.desktop.src}"  width="600px" />
      <mj-class name="hero-mobile" css-class="mobile-image" src="${urlpath}${hero.mobile.src}" />
      <mj-class name="logo-image" css-class="both" src="${urlpath}${logo.src}" alt="${logo.alt}" width="46px" padding="0px 25px" align="left" href="${logo.url}"/>

      <!-- Start colour scheme default -->
      <mj-class name="bg-color" background-color="#ffffff" />
      <mj-class name="text-color" color="#6C757D" />

      <mj-class name="pre-bg-color" background-color="#E0DDDB" />
      <mj-class name="pre-text-color" color="#000000" />

      <mj-class name="footer-bg-color" background-color="#F9F7F5" />
      <mj-class name="footer-text-color" color="#707372" />
      <!-- End colour scheme default -->


      <!-- Start colour scheme dark --><!--

      <mj-class name="bg-color" background-color="#000000" />
      <mj-class name="text-color" color="#E0E0E0" />

      <mj-class name="pre-bg-color" background-color="#1E1E1E" />
      <mj-class name="pre-text-color" color="#FFFFFF" />

      <mj-class name="footer-bg-color" background-color="#1A1A1A" />
      <mj-class name="footer-text-color" color="#A0A5A4" />
      --><!-- End colour scheme dark -->

    </mj-attributes>

    <mj-style>
      @media only screen and (max-width: 599px) {
        .mobile-image {
          display: block !important;
          width: 100% !important;
          height: auto !important;
        }
        .desktop-image {
          display: none !important;
        }
      }

      @media only screen and (min-width: 600px) {
        .desktop-image {
        display: block !important;
        width: 100% !important;
        height: auto !important;
        }
        .mobile-image {
          display: none !important;
        }
      }

      

      /* start css dark-mode */ /*
      .footer-raw-text {
        color: #A0A5A4!important
      }
      .pre-link-color {
        color: #FFFFFF!important
      }

      .cta-link {
        color: #FFFFFF!important;
      }
      */ /* end css dark-mode */
    </mj-style>

    <mj-style inline="inline">
    .cta-link {
      color: #343A40;
      font-weight: bold;
      text-decoration: none;
    }

    .cta-01-text {
      font-family:Arial, sans-serif; 
      font-size:13px; 
      line-height:18px; 
      color:#333333; 
      padding:10px 0; 
      border-bottom:1px solid #DD5900;
    }

    .cta-01-text-url  { 
      color:#333333; 
      text-decoration:none; 
      font-weight:bold;
    }

    .cta-01-arrow {
      width:15px; padding:0px; border-bottom:1px solid #DD5900;
    }

    .cta-01-arrow-img { 
      display:block; width:15px; height:15px; border:0; outline:none; text-decoration:none;
    }

    .table-content-text {
      font-family:Arial, sans-serif; 
      font-size:16px; 
      line-height:20px; 
      color:#333333; 
      padding:10px 0;
    }

    .table-content-bar { 
      width:3px; 
      background-color:#DD5900; 
      font-size:1px; 
      line-height:1px;
    }

    .safe-table {
      border-collapse:collapse; 
      mso-table-lspace:0pt; 
      mso-table-rspace:0pt;
    }

    .both {
          display: block !important;
        }


        .desktop-image {
        display: block;
        width: 100%;
        height: auto;
        }
        .mobile-image {
          display: none;
        }

    </mj-style>
  </mj-head>

  <mj-body mj-class="bg-color">
    <mj-section mj-class="pre-bg-color" padding="0">
      <mj-column padding="0" width="480px">
        <mj-text mj-class="pre-text-color" padding="10px 25px" font-size="10px" line-height="10px" align="center">
          Having trouble viewing this email? <a class="pre-link-color" href="#" style="color: #707372; text-decoration: underline;">View Online</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0">
      <mj-column>
        <mj-image mj-class="hero-image hero-desktop" />
        <edm-not-outlook-open>
          <mj-image mj-class="hero-image hero-mobile"  />
        <edm-not-outlook-close>
      </mj-column>
    </mj-section>

    <mj-section padding="0">
      <mj-column padding="0">
        <mj-spacer height="30px" padding="0"/>
      </mj-column>
    </mj-section>

    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0" width="480px">
        <mj-text mj-class="text-color" padding="0px 25px" font-size="24px" line-height="30px" align="left">
          Applications are now open for the 2027 BHP&nbsp;Xplor&nbsp;cohort. 
        </mj-text>
      </mj-column>
    </mj-section>


    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0">
        <mj-spacer height="20px" padding="0"/>
      </mj-column>
    </mj-section>

    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0" width="480px">
        <mj-text mj-class="text-color"  padding="0px 25px" font-size="16px" line-height="26px" align="left" >
          BHP Xplor gives mineral exploration companies funding, expertise and commercial support to help take what they believe in&nbsp;further.
          <br><br>
          Selected participants receive US$500,000 in equity-free funding, technical access, commercial support and industry connections across the nine-month&nbsp;program.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0">
        <mj-spacer height="20px" padding="0"/>
      </mj-column>
    </mj-section>

    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0" width="480px" >
        <mj-text mj-class="text-color" padding="0px 25px" font-size="24px" line-height="30px" align="left">

<table class="safe-table" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0">
  <tr>
    <!-- Left Accent Bar with Outlook MSO fix -->
    <td class="table-content-bar" width="3" valign="top">&nbsp;</td>
    <!-- Content Padding Cell -->
    <td style="padding:10px 0 10px 30px;">
      
      <!-- Intro Text -->
      <table class="safe-table" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td class="table-content-text">
            Hear what our previous participants think of Xplor:
          </td>
        </tr>
      </table>

      <!-- Item 1: Orion Minerals -->
      <table class="safe-table" role="presentation" width="120px" border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td class="cta-01-text">
            <a class="cta-01-text-url" href="${cta01.url}" target="_blank">${cta01.text}</a>
          </td>
          <td class="cta-01-arrow" width="15" align="right">
            <a href="${cta01.url}" target="_blank" style="text-decoration:none;">
              <img class="cta-01-arrow-img" src="${urlpath}${cta.arrow.src}" width="15" height="15" alt="">
            </a>
          </td>
        </tr>
      </table>

      <!-- Spacer -->
      <table class="safe-table" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td height="20" style="height:20px; font-size:0; line-height:20px;">&nbsp;</td>
        </tr>
      </table>

      <!-- Item 2: FrontierX -->
      <table class="safe-table" role="presentation" width="85px" border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td class="cta-01-text">
            <a class="cta-01-text-url" href="${cta02.url}" target="_blank">${cta02.text}</a>
          </td>
          <td class="cta-01-arrow" width="15" align="right">
            <a href="${cta02.url}" target="_blank" style="text-decoration:none;">
              <img class="cta-01-arrow-img" src="${urlpath}${cta.arrow.src}" width="15" height="15" alt="">
            </a>
          </td>
        </tr>
      </table>

      <!-- Spacer -->
      <table class="safe-table" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td height="20" style="height:20px; font-size:0; line-height:20px;">&nbsp;</td>
        </tr>
      </table>

    </td>
  </tr>
</table>


        </mj-text>
      </mj-column>
    </mj-section>

        <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0">
        <mj-spacer height="20px" padding="0"/>
      </mj-column>
    </mj-section>


    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0" width="480px">
        <mj-text mj-class="text-color"  padding="0px 25px" font-size="16px" line-height="26px" align="left" >
          Applications close 5&nbsp;October&nbsp;2026.
        </mj-text>
      </mj-column>
    </mj-section>



    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0">
        <mj-spacer height="20px" padding="0"/>
      </mj-column>
    </mj-section>

    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0" width="480px">
        <mj-text mj-class="text-color" padding="0px 25px" font-size="24px" line-height="30px" align="left">
          <table width="100" border="0" cellpadding="0" cellspacing="0" style="width: 100px; border-collapse: collapse;">
            <tr>
              <td width="85" style="width: 120px; font-family: Arial, sans-serif; font-size: 13px; color: #333333;">
                <a class="cta-link" href="${cta03.url}" target="blank">${cta03.text}</a>
              </td>
              <td width="15" style="width: 15px; line-height: 1px;">
                <a class="cta-link" href="${cta03.url}" target="blank"><img src="${urlpath}${cta.arrow.src}" width="15" height="15" alt="" style="display: block; width: 15px; height: auto;" /></a>
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0" width="480px">
        <mj-divider width="100px" border-width="1px" border-style="solid"  border-color="#DD5900" padding="0px 25px" align="left"/>
      </mj-column>
    </mj-section>

    <mj-section mj-class="bg-color" padding="0">
      <mj-column padding="0">
        <mj-spacer height="30px" padding="0"/>
      </mj-column>
    </mj-section>

    <mj-section mj-class="footer-bg-color" padding="0">
      <mj-column padding="0">
        <mj-spacer height="30px" padding="0" />
      </mj-column>
    </mj-section>

    <mj-section mj-class="footer-bg-color" padding="0">
      <mj-column width="96px" padding="0" vertical-align="bottom">
        <mj-image mj-class="logo-image" />
        <mj-text mj-class="text-color" padding="5px 0px 0px 25px" font-size="8px" line-height="8px" align="left">
          &copy; BHP 2026
        </mj-text>
      </mj-column>
      <mj-column padding="0" width="454px" vertical-align="bottom">
          <mj-raw>
            <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; table-layout: fixed; mso-table-lspace: 0pt; mso-table-rspace: 0pt;">
              <tr>
                <!-- Text Column -->
                <td valign="bottom" align="left" style="text-align: left; padding: 10px 0 0 25px; font-family: Arial, Helvetica, sans-serif; font-size: 10px; line-height: 14px; color: #000000; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
                  <span class="footer-raw-text" style="font-family: Arial, Helvetica, sans-serif; font-size: 10px; line-height: 14px; display: block;">
                    <strong style="font-weight: bold;">Stay in touch</strong><br>
                    Connect with us and keep up to date with the latest&nbsp;from&nbsp;BHP
                  </span>
                </td>
                <!-- Facebook Column -->
                <td width="28" valign="bottom" style="width: 22px; padding: 0 10px 0 10px;">
                  <a href="${icon01.url}" target="_blank" style="text-decoration: none; display: block; width: 28px;">
                    <img src="${urlpath}${icon01.src}" width="28" height="28" alt="${icon01.alt}" border="0" style="display: block; width: 28px; height: 28px; border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic;" />
                  </a>
                </td>
                <!-- Instagram Column -->
                <td width="28" valign="bottom" style="width: 22px; padding: 0 10px 0 0px;">
                  <a href="${icon02.url}" target="_blank" style="text-decoration: none; display: block; width: 28px;">
                    <img src="${urlpath}${icon02.src}" width="28" height="28" alt="${icon02.alt}" border="0" style="display: block; width: 28px; height: 28px; border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic;" />
                  </a>
                </td>
                <!-- YouTube Column -->
                <td width="28" valign="bottom" style="width: 22px; padding: 0 25px 0 0px;">
                  <a href="${icon03.url}" target="_blank" style="text-decoration: none; display: block; width: 28px;">
                    <img src="${urlpath}${icon03.src}" width="28" height="28" alt="${icon03.alt}" border="0" style="display: block; width: 28px; height: 28px; border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic;" />
                  </a>
                </td>
              </tr>
            </table>
          </mj-raw>
      </mj-column>
    </mj-section>

    <mj-section mj-class="footer-bg-color" padding="0">
      <mj-column padding="0">
        <mj-spacer height="30px" padding="0" />
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>