<mjml>
  <mj-head>
     <mj-breakpoint width="0px" />
    <mj-attributes>
      
      <!-- Start custom variables
      Create any variables below.  In code reference as ${variable}
      Though better to place vars in data.json.
      End custom variables -->

      <mj-all
        font-family="${font.family}"
      />
      <mj-text
        font-family="${font.family}"
        font-size="16px"
        line-height="24px"
      />


      <mj-image name="hero-image" alt="${hero.alt}" padding="0" />
      <mj-image name="hero-desktop" css-class="desktop-image" src="${paths.current}${hero.desktop.src}"  width="600px" />
      <mj-class name="logo-image" src="${paths.current}${logo.src}" alt="${logo.alt}" width="250px" padding="0px" align="left" href="${logo.url}"/>
      <mj-class name="logo-dual" src="${paths.current}${logoDual.src}" alt="${logoDual.alt}" width="600px" padding="0px" align="left" href="${logoDual.url}"/>
      <mj-class name="placeholder-image" src="${paths.current}${placeholder.src}" alt="${placeholder.alt}" width="88px" padding="0px " align="left"/>
      <mj-class name="cta" src="${paths.current}${cta.src}" alt="${cta.alt}" width="195px" padding="0px" align="left" href="${cta.url}"/>

      <!-- Start colour scheme default -->
      <mj-class name="bg-color" background-color="${theme.light.background}" />
      <mj-class name="text-color" color="${theme.light.text}" />
      <mj-class name="survey-color" background-color="${theme.light.survey.background}" color="${theme.light.survey.text}" />
      <mj-class name="pre-bg-color" background-color="${theme.light.preheader.background}" />
      <mj-class name="pre-text-color" color="${theme.light.preheader.text}"/>
      <mj-class name="footer-bg-color" background-color="${theme.light.footer.background}" />
      <mj-class name="footer-text-color" color="${theme.light.footer.text}" />
      <!-- End colour scheme default -->


      <!-- Start colour scheme dark --><!--
      <mj-class name="bg-color" background-color="${theme.dark.background}" />
      <mj-class name="text-color" color="${theme.dark.text}" />
      <mj-class name="survey-color" background-color="${theme.dark.survey.background}" color="${theme.dark.survey.text}" />
      <mj-class name="pre-bg-color" background-color="${theme.dark.preheader.background}" />
      <mj-class name="pre-text-color" color="${theme.dark.preheader.text}"/>
      <mj-class name="footer-bg-color" background-color="${theme.dark.footer.background}" />
      <mj-class name="footer-text-color" color="${theme.dark.footer.text}" />
      --><!-- End colour scheme dark -->

    </mj-attributes>


    <mj-style>

      /* start css dark-mode */ /*
      .footer-raw-text {
        color: ${theme.dark.footer.text}!important
      }
      .pre-link-color {
        color: ${theme.dark.preheader.text}!important
      }

      .cta-link {
        color: ${theme.dark.cta.text}!important;
      }

      .cta-text-url {
        color:${theme.dark.cta.text}!important;
      }

      .table-content-text {
        color:${theme.dark.text}!important;
      }

      .table-content-date {
        color:${theme.dark.text}!important; 
      }

      .table-content-time {
        color:${theme.dark.text}!important; 
      }

      .table-content-address {
        color:${theme.dark.text}!important; 
      }


      */ /* end css dark-mode */
    </mj-style>

    <mj-style inline="inline">
      
      .table-content-text {
        font-family:${font.family}; 
        font-size:16px; 
        line-height:20px; 
        color:${theme.light.text}; 
        padding:0px 0px 10px 0px;
      }

      .table-content-bar { 
        width:3px; 
        background-color:${theme.bar.background}; 
        font-size:1px; 
        line-height:1px;
      }

      .table-content-date {
        font-family:${font.family}; 
        font-size:14px; 
        font-weight: bold;
        line-height:20px; 
        color:${theme.light.module01.text}; 
        padding:0px 0px 10px 0px;
      }

      .table-content-time {
        font-family:${font.family}; 
        font-size:12px; 
        font-weight: bold;
        line-height:14px; 
        color:${theme.light.module01.text}; 
        padding:0px 0px 10px 0px;
      }

      .table-content-address {
        font-family:${font.family}; 
        font-size:12px; 
        font-weight: regular;
        line-height:16px; 
        color:${theme.light.module01.text}; 
        padding:0px 0px 10px 0px;
      }

      .safe-table {
        border-collapse:collapse; 
        mso-table-lspace:0pt; 
        mso-table-rspace:0pt;

        border-collapse: collapse; 
        mso-table-lspace: 0pt; 
        mso-table-rspace: 0pt; 
      }

      .table-cta-border {
        border-bottom: 1px solid ${theme.bar.background};
      }

      .footer-text {
        text-align: left; 
        padding: 10px 0 0 25px; 
        font-family: ${font.family}; 
        font-size: 10px; 
        line-height: 14px; 
        color: ${theme.light.footer.text}; 
        -webkit-text-size-adjust: 100%; 
        -ms-text-size-adjust: 100%;
      }

      .footer-raw-text {
        font-family: ${font.family}; font-size: 10px; line-height: 14px; display: block;
      }

      .footer-icon-img {
        display: block; 
        width: 28px; 
        height: 28px; 
        border: 0; 
        outline: none; 
        text-decoration: none; 
        -ms-interpolation-mode: bicubic;
      }

      .footer-icon-link {
        text-decoration: none; 
        display: block; 
        width: 28px;
      }

      .img-href {
        text-decoration: none; 
        display: block; 
        font-size: 0px; 
        line-height: 0px;
      }

      .pre-link-color {
        color: ${theme.light.preheader.text}; 
        text-decoration: underline;
      }


    </mj-style>

  </mj-head>

  <mj-body mj-class="bg-color" width="600px">
  


    <mj-section mj-class="module-01-color" width="50" padding="0">
      <mj-column padding="0">
        <mj-raw>
        <!-- start raw code -->
  <table
    role="presentation"
    width="100%"
    border="0"
    cellpadding="0"
    cellspacing="0"
    style="width:100%;margin:0;padding:0;border-collapse:collapse;"
  >
    <tr>
      <td align="center" style="padding:0;">

        <!--[if mso]>
        <table role="presentation" width="600" border="0" cellpadding="0" cellspacing="0" style="width:600px;">
          <tr>
            <td width="600" style="width:600px;padding:0;">
        <![endif]-->

        <table
          role="presentation"
          width="600"
          border="0"
          cellpadding="0"
          cellspacing="0"
          style="width:100%;max-width:600px;margin:0 auto;border-collapse:collapse;"
        >

          <!-- Logo -->
          <tr>
            <td
              width="600"
              style="width:600px;padding:0;font-size:0;line-height:0;"
            >
              <img
                src="${paths.current}${logoDual.src}"
                width="600"
                alt=""
                border="0"
                style="display:block;width:600px;max-width:100%;height:auto;border:0;"
              >
            </td>
          </tr>

          <!-- Hero -->
          <tr>
            <td
              width="600"
              style="width:600px;padding:0;font-size:0;line-height:0;"
            >
              <img
                src="${paths.current}${hero.desktop.src}"
                width="600"
                alt=""
                border="0"
                style="display:block;width:600px;max-width:100%;height:auto;border:0;"
              >
            </td>
          </tr>

          <!-- Spacer 40 -->
          <tr>
            <td height="40" style="height:40px;padding:0;font-size:0;line-height:0;">
              &nbsp;
            </td>
          </tr>

          <!-- Introduction -->
          <tr>
            <td
              width="600"
              style="width:600px;padding:0 40px;background-color:${theme.light.background};font-family:Arial,Helvetica,sans-serif;font-size:19px;line-height:26px;color:${theme.light.text};text-align:left;"
            >
              Hi {First name},
              <br><br>
              We’re inviting people across the industry to take part in a short survey to help us better understand the value commercial partnerships bring to our industry.
              <br><br>
              Your feedback will contribute to a broader understanding of partnership effectiveness, supporting more informed decision-making for future industry initiatives.
              <br><br>
              The survey takes around 10 minutes to complete. As a thank you for your time, you’ll go into the draw to <strong>win one of five $200 VISA eGift Cards.<sup>*</sup></strong>
            </td>
          </tr>

          <!-- Spacer 40 -->
          <tr>
            <td height="40" style="height:40px;padding:0;font-size:0;line-height:0;">
              &nbsp;
            </td>
          </tr>

          <!-- Survey background -->
          <tr>
            <td
              height="40"
              style="height:40px;padding:0;background-color:${theme.light.survey.background};font-size:0;line-height:0;"
            >
              &nbsp;
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td
              align="center"
              style="padding:0;background-color:${theme.light.survey.background};"
            >
              <table
                role="presentation"
                width="195"
                border="0"
                cellpadding="0"
                cellspacing="0"
                align="center"
                style="width:195px;border-collapse:collapse;"
              >
                <tr>
                  <td
                    width="195"
                    style="width:195px;padding:0;font-size:0;line-height:0;"
                  >
                    <a
                      href="${cta.url}"
                      target="_blank"
                      style="text-decoration:none;"
                    >
                      <img
                        src="${paths.current}${cta.src}"
                        width="195"
                        alt="${cta.alt || ''}"
                        border="0"
                        style="display:block;width:195px;height:auto;border:0;"
                      >
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Spacer 20 -->
          <tr>
            <td
              height="20"
              style="height:20px;padding:0;background-color:${theme.light.survey.background};font-size:0;line-height:0;"
            >
              &nbsp;
            </td>
          </tr>

          <!-- Survey information -->
          <tr>
            <td
              width="600"
              align="center"
              style="width:600px;padding:0 40px;background-color:${theme.light.survey.background};font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:26px;color:${theme.light.survey.text};text-align:center;"
            >
              The survey closes [XX/XX/XX].
              <br><br>
              Your responses are confidential and will be used for research purposes. Individual responses will not be identified.
            </td>
          </tr>

          <!-- Spacer 40 -->
          <tr>
            <td
              height="40"
              style="height:40px;padding:0;background-color:${theme.light.survey.background};font-size:0;line-height:0;"
            >
              &nbsp;
            </td>
          </tr>

          <!-- Spacer 20 -->
          <tr>
            <td
              height="20"
              style="height:20px;padding:0;background-color:${theme.light.background};font-size:0;line-height:0;"
            >
              &nbsp;
            </td>
          </tr>

          <!-- Terms and conditions -->
          <tr>
            <td
              width="600"
              style="width:600px;padding:0 40px;background-color:${theme.light.background};font-family:Arial,Helvetica,sans-serif;color:${theme.light.text};text-align:left;"
            >

              <div
                style="font-size:17px;line-height:26px;font-weight:bold;"
              >
                Terms &amp; Conditions
              </div>

              <div
                style="font-size:11px;line-height:14px;font-weight:normal;"
              >
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aenean sit amet lorem sit amet elit blandit porta. Vestibulum sagittis ante nec fermentum dignissim. Quisque suscipit id orci vitae mattis. Donec sed augue nulla. Aenean et sapien efficitur, hendrerit leo a, faucibus justo. Nulla cursus ultricies faucibus.
              </div>

            </td>
          </tr>

          <!-- Spacer 20 -->
          <tr>
            <td
              height="20"
              style="height:20px;padding:0;background-color:${bg-color};font-size:0;line-height:0;"
            >
              &nbsp;
            </td>
          </tr>

        </table>

        <!--[if mso]>
            </td>
          </tr>
        </table>
        <![endif]-->

      </td>
    </tr>
  </table>

<!-- end raw code -->
  </mj-raw>
      </mj-column>
    </mj-section>


  </mj-body>
</mjml>